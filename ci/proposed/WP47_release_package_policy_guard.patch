     with tempfile.TemporaryDirectory(prefix="hrai_pkgpolicy_") as td:
         staging = Path(td) / root_name
         staging.mkdir()
@@ -271,6 +303,7 @@ def main(argv: list[str] | None = None) -> int:
                 registry_relpath=args.registry_relpath,
             )
         else:
