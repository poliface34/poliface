{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.insenai.com.tr/schemas/hrai/hukuk_sgk/cba_contract_practice_card.schema.json",
  "title": "hrAI @HukukSGK — L6 TİS, Bireysel Sözleşme, İç Yönetmelik ve İşyeri Uygulaması Şeması (v1.0.5.1)",
  "description": "L6 özerk norm katmanı için bağımsız Draft 2020-12 şeması. TİS (6356), bireysel iş sözleşmesi, işyeri iç yönetmeliği ve yerleşik işyeri uygulamasını birbirine indirgemeden ve tekil priority:8 üstünlüğü kurmadan modeller.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "layer_id",
    "product_brand",
    "coordinator_agent",
    "specialist_agent",
    "module_id",
    "source_document_id",
    "autonomous_source_kind",
    "title",
    "scope_summary",
    "adoption_status",
    "template_only_not_binding_company_policy",
    "no_flat_priority_supremacy",
    "non_reducible_source_distinction",
    "primary_statutory_basis_ids",
    "rules",
    "disclaimer"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.5.1"
    },
    "layer_id": {
      "type": "string",
      "const": "L6_CBA_CONTRACTS_AND_WORKPLACE_PRACTICES"
    },
    "product_brand": {
      "type": "string",
      "const": "hrAI"
    },
    "coordinator_agent": {
      "type": "string",
      "const": "@hrAI"
    },
    "specialist_agent": {
      "type": "string",
      "const": "@HukukSGK"
    },
    "module_id": {
      "type": "string",
      "pattern": "^MOD-L6-[A-Z0-9\\-_]{3,40}$"
    },
    "source_document_id": {
      "type": "string",
      "pattern": "^HRAI-L6-[A-Z0-9\\-_]{3,40}$"
    },
    "autonomous_source_kind": {
      "type": "string",
      "enum": [
        "COLLECTIVE_BARGAINING_AGREEMENT",
        "INDIVIDUAL_EMPLOYMENT_CONTRACT",
        "WORKPLACE_INTERNAL_REGULATION",
        "ESTABLISHED_WORKPLACE_PRACTICE"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "scope_summary": {
      "type": "string",
      "minLength": 20
    },
    "adoption_status": {
      "type": "string",
      "enum": [
        "REFERENCE_TEMPLATE_PENDING_COMPANY_ADOPTION",
        "COMPANY_ADOPTED_PENDING_COUNSEL_REVIEW",
        "COMPANY_ADOPTED_COUNSEL_VERIFIED",
        "SUPERSEDED"
      ]
    },
    "template_only_not_binding_company_policy": {
      "type": "boolean"
    },
    "no_flat_priority_supremacy": {
      "type": "boolean",
      "const": true
    },
    "non_reducible_source_distinction": {
      "type": "string",
      "minLength": 25
    },
    "primary_statutory_basis_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 4
      }
    },
    "rules": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/l6_autonomous_rule"
      }
    },
    "disclaimer": {
      "type": "string",
      "minLength": 20
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "adoption_status": {
            "const": "REFERENCE_TEMPLATE_PENDING_COMPANY_ADOPTION"
          }
        },
        "required": [
          "adoption_status"
        ]
      },
      "then": {
        "properties": {
          "template_only_not_binding_company_policy": {
            "const": true
          }
        }
      }
    }
  ],
  "$defs": {
    "l6_autonomous_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "title",
        "rule_summary",
        "norm_type",
        "legal_basis_ids",
        "source_document_id",
        "adoption_status",
        "employee_favorable_check",
        "conflict_resolution",
        "human_review_required"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^RULE-L6-[A-Z0-9\\-_]{3,50}$"
        },
        "title": {
          "type": "string",
          "minLength": 5
        },
        "rule_summary": {
          "type": "string",
          "minLength": 20
        },
        "norm_type": {
          "type": "string",
          "enum": [
            "STATUTORY_ABSOLUTE_MANDATORY",
            "STATUTORY_RELATIVE_MANDATORY",
            "STATUTORY_SUPPLEMENTARY",
            "COLLECTIVE_BARGAINING_AGREEMENT",
            "INDIVIDUAL_EMPLOYMENT_CONTRACT",
            "WORKPLACE_INTERNAL_REGULATION",
            "ESTABLISHED_WORKPLACE_PRACTICE"
          ]
        },
        "legal_basis_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 4
          }
        },
        "source_document_id": {
          "type": "string",
          "pattern": "^HRAI-L6-[A-Z0-9\\-_]{3,40}$"
        },
        "adoption_status": {
          "type": "string",
          "enum": [
            "REFERENCE_TEMPLATE_PENDING_COMPANY_ADOPTION",
            "COMPANY_ADOPTED_PENDING_COUNSEL_REVIEW",
            "COMPANY_ADOPTED_COUNSEL_VERIFIED",
            "SUPERSEDED"
          ]
        },
        "employee_favorable_check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applicable",
            "statutory_floor_nature",
            "can_improve_for_employee",
            "can_derogate_against_employee",
            "evaluation_criteria"
          ],
          "properties": {
            "applicable": {
              "type": "boolean"
            },
            "statutory_floor_nature": {
              "type": "string",
              "enum": [
                "ABSOLUTE_MANDATORY",
                "RELATIVE_MANDATORY_FLOOR",
                "SUPPLEMENTARY_DEFAULT"
              ]
            },
            "can_improve_for_employee": {
              "type": "boolean"
            },
            "can_derogate_against_employee": {
              "type": "boolean"
            },
            "evaluation_criteria": {
              "type": "string",
              "minLength": 15
            }
          }
        },
        "conflict_resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "higher_authority_ref",
            "cannot_override_statutory_floor",
            "distinct_from_other_autonomous_sources",
            "rationale"
          ],
          "properties": {
            "strategy": {
              "type": "string",
              "enum": [
                "STATUTORY_ABSOLUTE_PREVAILS",
                "EMPLOYEE_FAVORABLE_COMPARISON_WITH_MANDATORY_FLOOR",
                "CBA_OVERRIDES_LESS_FAVORABLE_CONTRACT_6356_M36",
                "ESSENTIAL_CHANGE_WRITTEN_CONSENT_4857_M22",
                "SUPPLEMENTARY_CONTRACT_OR_PRACTICE_APPLIES",
                "COUNSEL_ESCALATION_REQUIRED"
              ]
            },
            "higher_authority_ref": {
              "type": "string",
              "minLength": 4
            },
            "cannot_override_statutory_floor": {
              "type": "boolean"
            },
            "distinct_from_other_autonomous_sources": {
              "type": "string",
              "minLength": 15
            },
            "rationale": {
              "type": "string",
              "minLength": 20
            }
          }
        },
        "human_review_required": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "adoption_status": {
                "not": {
                  "const": "COMPANY_ADOPTED_COUNSEL_VERIFIED"
                }
              }
            },
            "required": [
              "adoption_status"
            ]
          },
          "then": {
            "properties": {
              "human_review_required": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "employee_favorable_check": {
                "properties": {
                  "statutory_floor_nature": {
                    "const": "ABSOLUTE_MANDATORY"
                  }
                },
                "required": [
                  "statutory_floor_nature"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "employee_favorable_check": {
                "properties": {
                  "can_derogate_against_employee": {
                    "const": false
                  }
                }
              },
              "conflict_resolution": {
                "properties": {
                  "cannot_override_statutory_floor": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
