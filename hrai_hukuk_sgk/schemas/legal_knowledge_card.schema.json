{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calisora.local/schemas/legal_knowledge_card.schema.json",
  "title": "hrAI @HukukSGK Uygulanabilir Mevzuat Bilgi Kartı Şeması (v1.0.5.1)",
  "description": "Kanun, yönetmelik, tebliğ ve genelgelerin madde bazında uygulanabilir bilgi kartları için doğrulama şeması. Kaynak doğrulaması (source_verification) ile hukuki yorum doğrulaması (legal_interpretation_verification) iki ayrı kontrol olarak zorunludur; yürürlük tarihi ve her iki doğrulama da VERIFIED olmadan kart VERIFIED durumuna alınamaz.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "law_no",
    "law_title",
    "source_id",
    "cards"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+[a-z0-9.\\-]*$"
    },
    "law_no": {
      "type": "string",
      "minLength": 1
    },
    "law_title": {
      "type": "string",
      "minLength": 5
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9\\-_]{2,63}$"
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/knowledgeCard"
      }
    }
  },
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "knowledgeCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "source_id",
        "law_no",
        "article_ref",
        "topic",
        "legal_basis",
        "scope_of_application",
        "exceptions",
        "required_documents",
        "related_precedent_ids",
        "precedent_note",
        "effective_validity",
        "norm_character",
        "risks",
        "primary_specialist",
        "collaborating_specialists",
        "disclaimer",
        "verification_status",
        "source_verification",
        "legal_interpretation_verification",
        "verification_audit"
      ],
      "properties": {
        "card_id": {
          "type": "string",
          "pattern": "^CARD-[A-Z0-9\\-_]{3,50}$"
        },
        "source_id": {
          "type": "string"
        },
        "law_no": {
          "type": "string"
        },
        "article_ref": {
          "type": "string",
          "minLength": 2
        },
        "topic": {
          "type": "string",
          "minLength": 5
        },
        "legal_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_id",
            "original_publication_ref",
            "consolidated_text_url",
            "amendment_history"
          ],
          "properties": {
            "source_id": {
              "type": "string"
            },
            "original_publication_ref": {
              "type": "string",
              "minLength": 5
            },
            "consolidated_text_url": {
              "type": "string",
              "pattern": "^https://.+"
            },
            "secondary_statutory_anchors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "amendment_history": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "amending_law_no",
                  "official_gazette_no",
                  "publication_date",
                  "effective_from",
                  "summary"
                ],
                "properties": {
                  "amending_law_no": {
                    "type": "string"
                  },
                  "official_gazette_no": {
                    "type": "string"
                  },
                  "publication_date": {
                    "$ref": "#/$defs/isoDate"
                  },
                  "effective_from": {
                    "$ref": "#/$defs/isoDate"
                  },
                  "summary": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "scope_of_application": {
          "type": "string",
          "minLength": 15
        },
        "application_scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scenario_id",
              "condition",
              "legal_rule",
              "statutory_basis"
            ],
            "properties": {
              "scenario_id": {
                "type": "string",
                "minLength": 2
              },
              "condition": {
                "type": "string",
                "minLength": 5
              },
              "legal_rule": {
                "type": "string",
                "minLength": 5
              },
              "statutory_basis": {
                "type": "string",
                "minLength": 3
              }
            }
          }
        },
        "data_category_controls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "legal_basis",
              "purpose_and_necessity_limit",
              "proportionality_rule",
              "access_control",
              "retention_policy"
            ],
            "properties": {
              "category": {
                "type": "string"
              },
              "legal_basis": {
                "type": "string"
              },
              "purpose_and_necessity_limit": {
                "type": "string"
              },
              "explicit_consent_rule": {
                "type": "string"
              },
              "proportionality_rule": {
                "type": "string"
              },
              "access_control": {
                "type": "string"
              },
              "retention_policy": {
                "type": "string"
              }
            }
          }
        },
        "special_calculation_rules": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "statutory_subordination": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "concretizes_statutory_provisions",
            "cannot_override_parent_law",
            "hierarchy_note"
          ],
          "properties": {
            "concretizes_statutory_provisions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "cannot_override_parent_law": {
              "type": "boolean",
              "const": true
            },
            "hierarchy_note": {
              "type": "string",
              "minLength": 15
            }
          }
        },
        "exceptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "required_documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "related_precedent_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "precedent_note": {
          "type": "string",
          "minLength": 10
        },
        "effective_validity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effective_from",
            "effective_to",
            "effective_date_verified",
            "effective_date_basis"
          ],
          "properties": {
            "effective_from": {
              "$ref": "#/$defs/isoDate"
            },
            "effective_to": {
              "$ref": "#/$defs/isoDate"
            },
            "effective_date_verified": {
              "type": "boolean"
            },
            "effective_date_basis": {
              "type": "string",
              "minLength": 5
            }
          }
        },
        "norm_character": {
          "type": "string",
          "enum": [
            "ABSOLUTE_MANDATORY",
            "RELATIVE_EMPLOYEE_FAVORABLE",
            "DISPOSITIVE"
          ]
        },
        "risks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "primary_specialist": {
          "type": "string",
          "const": "@HukukSGK"
        },
        "collaborating_specialists": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disclaimer": {
          "type": "string",
          "minLength": 20
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "DRAFT",
            "PENDING_EFFECTIVE_DATE_CHECK",
            "PENDING_LEGAL_REVIEW",
            "SUPERSEDED"
          ]
        },
        "source_verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "source_id",
            "source_audit_log_id",
            "verified_at"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "VERIFIED",
                "PENDING",
                "FAILED"
              ]
            },
            "source_id": {
              "type": "string"
            },
            "source_audit_log_id": {
              "type": "string",
              "pattern": "^AUD-\\d{8}-[A-Z0-9\\-_]{2,32}$"
            },
            "verified_at": {
              "type": "string"
            }
          }
        },
        "legal_interpretation_verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reviewer_id",
            "reviewer_role",
            "reviewed_at",
            "checked_aspects",
            "review_notes"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "VERIFIED",
                "PENDING_LEGAL_REVIEW",
                "REJECTED"
              ]
            },
            "reviewer_id": {
              "type": "string",
              "pattern": "^[A-Z0-9][A-Z0-9\\-_]{2,40}$"
            },
            "reviewer_role": {
              "type": "string",
              "enum": [
                "SENIOR_LABOR_LAW_REVIEWER",
                "SGK_COMPLIANCE_SPECIALIST",
                "EXTERNAL_LEGAL_COUNSEL",
                "LEGAL_OPS_AUDITOR"
              ]
            },
            "reviewed_at": {
              "$ref": "#/$defs/isoDate"
            },
            "checked_aspects": {
              "type": "array",
              "minItems": 4,
              "items": {
                "type": "string",
                "enum": [
                  "ARTICLE_TEXT",
                  "EFFECTIVE_DATES",
                  "EXCEPTIONS",
                  "PERIODS_AND_THRESHOLDS",
                  "APPLICATION_SCENARIOS",
                  "STATUTORY_DISTINCTION"
                ]
              }
            },
            "review_notes": {
              "type": "string",
              "minLength": 10
            }
          }
        },
        "verification_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verifier_id",
            "verifier_role",
            "verification_method",
            "audit_log_id",
            "verified_at"
          ],
          "properties": {
            "verifier_id": {
              "type": "string",
              "pattern": "^[A-Z0-9][A-Z0-9\\-_]{2,40}$"
            },
            "verifier_role": {
              "type": "string",
              "enum": [
                "SENIOR_LABOR_LAW_REVIEWER",
                "SGK_COMPLIANCE_SPECIALIST",
                "EXTERNAL_LEGAL_COUNSEL",
                "LEGAL_OPS_AUDITOR"
              ]
            },
            "verification_method": {
              "type": "string",
              "minLength": 5
            },
            "audit_log_id": {
              "type": "string",
              "pattern": "^AUD-\\d{8}-[A-Z0-9\\-_]{2,32}$"
            },
            "verified_at": {
              "type": "string"
            }
          }
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification_status": {
                "const": "VERIFIED"
              }
            },
            "required": [
              "verification_status"
            ]
          },
          "then": {
            "properties": {
              "effective_validity": {
                "properties": {
                  "effective_date_verified": {
                    "const": true
                  }
                }
              },
              "source_verification": {
                "properties": {
                  "status": {
                    "const": "VERIFIED"
                  }
                }
              },
              "legal_interpretation_verification": {
                "properties": {
                  "status": {
                    "const": "VERIFIED"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_verification": {
                "properties": {
                  "status": {
                    "enum": [
                      "PENDING",
                      "FAILED"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "source_verification"
            ]
          },
          "then": {
            "properties": {
              "verification_status": {
                "not": {
                  "const": "VERIFIED"
                }
              },
              "legal_interpretation_verification": {
                "properties": {
                  "status": {
                    "not": {
                      "const": "VERIFIED"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
