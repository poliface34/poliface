{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calisora.local/schemas/trust_root_config.schema.json",
  "title": "hrAI @HukukSGK Üretim Güven Kökü Yapılandırma Şeması (v1.0.5.1)",
  "description": "GCP öncelikli (Frankfurt / europe-west3) ve PKCS#11 HSM alternatifli, sağlayıcıdan bağımsız üretim güven kökü yapılandırması, WORM Bucket Lock onay kapısı, KVKK m.9 veri yerleşimi bildirimi ve 5070 s. Kanun kapsam sınırı şeması.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "description",
    "deployment_status",
    "architecture_mode",
    "provider_agnostic_interfaces",
    "gcp_primary",
    "pkcs11_alternative",
    "rfc3161_tsa",
    "external_trust_anchor",
    "kvkk_and_data_residency",
    "law_5070_scope_boundary",
    "production_authorization_policy",
    "deferred_to_v1_0_5"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.5.1"
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "deployment_status": {
      "type": "string",
      "enum": [
        "NOT_CONFIGURED",
        "STAGING_SANDBOX",
        "LIVE_PRODUCTION"
      ]
    },
    "architecture_mode": {
      "type": "string",
      "const": "GCP_PRIMARY_PROVIDER_AGNOSTIC_HYBRID"
    },
    "provider_agnostic_interfaces": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "KeySignerProvider",
          "TimestampAuthorityProvider",
          "ImmutableEvidenceStorageProvider",
          "ExternalTrustAnchorProvider",
          "SourceAcquisitionProvider",
          "ProductionAuthorizationProvider"
        ]
      }
    },
    "gcp_primary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "region",
        "security_project_id",
        "app_project_id",
        "separate_security_project_required",
        "cloud_kms",
        "cloud_storage_worm",
        "cloud_run",
        "cloud_sql_postgresql"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "const": "GOOGLE_CLOUD_PLATFORM"
        },
        "region": {
          "type": "string",
          "const": "europe-west3"
        },
        "security_project_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "app_project_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "separate_security_project_required": {
          "type": "boolean",
          "const": true
        },
        "cloud_kms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "protection_level",
            "require_hsm_in_production",
            "supported_algorithms",
            "key_ring",
            "counsel_signing_key_ref",
            "checkpoint_sealer_key_ref",
            "source_acquisition_key_ref",
            "no_private_keys_in_repo"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "protection_level": {
              "type": "string",
              "const": "HSM"
            },
            "require_hsm_in_production": {
              "type": "boolean",
              "const": true
            },
            "supported_algorithms": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "ED25519",
                  "RSA-PSS-SHA256"
                ]
              }
            },
            "key_ring": {
              "type": [
                "string",
                "null"
              ]
            },
            "counsel_signing_key_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "checkpoint_sealer_key_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_acquisition_key_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "no_private_keys_in_repo": {
              "type": "boolean",
              "const": true
            }
          }
        },
        "cloud_storage_worm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "region",
            "bucket_name",
            "retention_policy_seconds",
            "bucket_lock_applied",
            "legal_retention_policy_approved",
            "legal_retention_approval_reference",
            "require_explicit_irreversible_confirmation",
            "bucket_lock_irreversible_warning"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "region": {
              "type": "string",
              "const": "europe-west3"
            },
            "bucket_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "retention_policy_seconds": {
              "type": "integer",
              "minimum": 86400
            },
            "bucket_lock_applied": {
              "type": "boolean"
            },
            "legal_retention_policy_approved": {
              "type": "boolean"
            },
            "legal_retention_approval_reference": {
              "type": [
                "string",
                "null"
              ]
            },
            "require_explicit_irreversible_confirmation": {
              "type": "boolean",
              "const": true
            },
            "bucket_lock_irreversible_warning": {
              "type": "string",
              "minLength": 20
            }
          }
        },
        "cloud_run": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "region",
            "service_name",
            "service_account_email",
            "ingress_policy"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "region": {
              "type": "string",
              "const": "europe-west3"
            },
            "service_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "service_account_email": {
              "type": [
                "string",
                "null"
              ]
            },
            "ingress_policy": {
              "type": "string",
              "enum": [
                "INTERNAL_ONLY",
                "INTERNAL_AND_CLOUD_LOAD_BALANCING"
              ]
            }
          }
        },
        "cloud_sql_postgresql": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "region",
            "instance_connection_name",
            "database_name",
            "ssl_mode",
            "role_description"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "region": {
              "type": "string",
              "const": "europe-west3"
            },
            "instance_connection_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "database_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "ssl_mode": {
              "type": "string",
              "const": "VERIFY_CA"
            },
            "role_description": {
              "type": "string",
              "minLength": 15
            }
          }
        }
      }
    },
    "pkcs11_alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "purpose",
        "library_path",
        "token_label",
        "slot_id",
        "supported_algorithms"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "purpose": {
          "type": "string",
          "minLength": 15
        },
        "library_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "token_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "slot_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "supported_algorithms": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "ED25519",
              "RSA-PSS-SHA256"
            ]
          }
        }
      }
    },
    "rfc3161_tsa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "independent_provider_required",
        "tsa_url",
        "trusted_ca_pem_path",
        "hash_algorithm",
        "nonce_required"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "independent_provider_required": {
          "type": "boolean",
          "const": true
        },
        "tsa_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "trusted_ca_pem_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "hash_algorithm": {
          "type": "string",
          "const": "SHA-256"
        },
        "nonce_required": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "external_trust_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_uri",
        "read_only",
        "separate_security_project_required",
        "in_app_json_forbidden",
        "kms_hsm_signature_required",
        "worm_storage_required",
        "independent_audit_log_required",
        "fail_closed_on_unavailable"
      ],
      "properties": {
        "manifest_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "read_only": {
          "type": "boolean",
          "const": true
        },
        "separate_security_project_required": {
          "type": "boolean",
          "const": true
        },
        "in_app_json_forbidden": {
          "type": "boolean",
          "const": true
        },
        "kms_hsm_signature_required": {
          "type": "boolean",
          "const": true
        },
        "worm_storage_required": {
          "type": "boolean",
          "const": true
        },
        "independent_audit_log_required": {
          "type": "boolean",
          "const": true
        },
        "fail_closed_on_unavailable": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "kvkk_and_data_residency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_region",
        "kvkk_m9_assessment_status",
        "kvkk_m9_assessment_approved",
        "kvkk_data_residency_notice"
      ],
      "properties": {
        "primary_region": {
          "type": "string",
          "const": "europe-west3"
        },
        "kvkk_m9_assessment_status": {
          "type": "string",
          "enum": [
            "PENDING_KVKK_M9_DATA_RESIDENCY_ASSESSMENT",
            "APPROVED"
          ]
        },
        "kvkk_m9_assessment_approved": {
          "type": "boolean"
        },
        "kvkk_data_residency_notice": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "law_5070_scope_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v1_0_3_scope",
        "qualified_e_signature_5070_equivalent",
        "nes_cades_xades_target_release",
        "boundary_notice"
      ],
      "properties": {
        "v1_0_3_scope": {
          "type": "string",
          "const": "TECHNICAL_KMS_HSM_AND_RFC3161_TSA_ONLY"
        },
        "qualified_e_signature_5070_equivalent": {
          "type": "boolean",
          "const": false
        },
        "nes_cades_xades_target_release": {
          "type": "string",
          "const": "1.0.4"
        },
        "boundary_notice": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "production_authorization_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "three_way_status_separation",
        "production_use_authorized",
        "external_legal_counsel_signoff_status",
        "mock_providers_can_authorize_production",
        "tls_alone_proves_historical_content"
      ],
      "properties": {
        "three_way_status_separation": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "technical_verification_status",
              "legal_counsel_attestation_status",
              "production_authorization_status"
            ]
          }
        },
        "production_use_authorized": {
          "type": "boolean"
        },
        "external_legal_counsel_signoff_status": {
          "type": "string",
          "enum": [
            "PENDING_SIGNED_EXTERNAL_ATTESTATION",
            "SIGNED_LEGAL_ATTESTATION_VERIFIED"
          ]
        },
        "mock_providers_can_authorize_production": {
          "type": "boolean",
          "const": false
        },
        "tls_alone_proves_historical_content": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "deferred_to_v1_0_5": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 5
      }
    }
  }
}
