{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calisora.local/schemas/yargitay_precedent_registry.schema.json",
  "title": "hrAI @HukukSGK Yargıtay İçtihat Kayıt Defteri Şeması (v1.0.5.1)",
  "description": "Yargıtay kararları için sıfır-uydurma şeması. Tam metin doğrulaması, sonuç/hüküm bölümü, kapsam sınırlamaları ve denetim izi ayrı ayrı doğrulanmak zorundadır.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "description",
    "precedents"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+[a-z0-9.\\-]*$"
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "precedents": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/precedentRecord"
      }
    }
  },
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "officialPrecedentUrl": {
      "type": "string",
      "pattern": "^https://(www\\.)?(resmigazete\\.gov\\.tr|karararama\\.yargitay\\.gov\\.tr|yargitay\\.gov\\.tr|anayasa\\.gov\\.tr|mevzuat\\.adalet\\.gov\\.tr)/.+$"
    },
    "precedentRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precedent_id",
        "chamber",
        "binding_level",
        "esas_no",
        "karar_no",
        "decision_date",
        "official_source_url",
        "related_source_ids",
        "legal_principle",
        "scope_limitations",
        "full_text_verification",
        "operative_holding",
        "scope_limitations_detail",
        "verification_status",
        "verified_by",
        "last_verified_at",
        "verification_audit"
      ],
      "properties": {
        "precedent_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9\\-_]{3,63}$"
        },
        "chamber": {
          "type": "string",
          "enum": [
            "YIBBGK",
            "HGK",
            "9_HD",
            "22_HD_HISTORICAL",
            "10_HD",
            "21_HD_HISTORICAL",
            "AYM"
          ]
        },
        "binding_level": {
          "type": "string",
          "enum": [
            "STATUTORY_BINDING_YIBBGK",
            "HGK_PERSUASIVE",
            "CHAMBER_SETTLED",
            "CHAMBER_ISOLATED"
          ]
        },
        "esas_no": {
          "type": "string",
          "pattern": "^\\d{4}/\\d+$"
        },
        "karar_no": {
          "type": "string",
          "pattern": "^\\d{4}/\\d+$"
        },
        "decision_date": {
          "$ref": "#/$defs/isoDate"
        },
        "official_gazette_no": {
          "type": [
            "string",
            "null"
          ]
        },
        "official_gazette_date": {
          "oneOf": [
            {
              "$ref": "#/$defs/isoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "official_source_url": {
          "$ref": "#/$defs/officialPrecedentUrl"
        },
        "url_granularity": {
          "type": "string",
          "enum": [
            "DIRECT_DOCUMENT",
            "ISSUE_INDEX"
          ],
          "default": "DIRECT_DOCUMENT"
        },
        "related_source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "legal_principle": {
          "type": "string",
          "minLength": 20
        },
        "scope_limitations": {
          "type": "string",
          "minLength": 10
        },
        "full_text_verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "official_source_url",
            "retrieved_http_status",
            "retrieved_content_sha256",
            "verified_at",
            "verifier_id"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "FETCHED_AND_MATCHED",
                "METADATA_VERIFIED_PENDING_LIVE_FETCH",
                "UNVERIFIED"
              ]
            },
            "official_source_url": {
              "$ref": "#/$defs/officialPrecedentUrl"
            },
            "retrieved_http_status": {
              "type": [
                "integer",
                "null"
              ]
            },
            "retrieved_content_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{64}$"
            },
            "verified_at": {
              "type": "string"
            },
            "verifier_id": {
              "type": "string",
              "minLength": 3
            }
          }
        },
        "operative_holding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "vote_majority",
            "verified_against_gazette"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 20
            },
            "vote_majority": {
              "type": "string",
              "minLength": 3
            },
            "verified_against_gazette": {
              "type": "boolean"
            }
          }
        },
        "scope_limitations_detail": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applies_to",
            "does_not_apply_to",
            "statutory_anchors",
            "verified_by_legal_review"
          ],
          "properties": {
            "applies_to": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "does_not_apply_to": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "statutory_anchors": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "verified_by_legal_review": {
              "type": "boolean"
            }
          }
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "PENDING_REVIEW",
            "SUPERSEDED",
            "CONFLICTING",
            "UNVERIFIED"
          ]
        },
        "verified_by": {
          "type": "string",
          "minLength": 3
        },
        "last_verified_at": {
          "$ref": "#/$defs/isoDate"
        },
        "verification_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verifier_id",
            "verifier_role",
            "verification_method",
            "audit_log_id",
            "verified_at",
            "document_fetch_status",
            "expected_text_markers",
            "matched_text_markers"
          ],
          "properties": {
            "verifier_id": {
              "type": "string",
              "pattern": "^[A-Z0-9][A-Z0-9\\-_]{2,40}$"
            },
            "verifier_role": {
              "type": "string",
              "enum": [
                "SENIOR_LABOR_LAW_REVIEWER",
                "SGK_COMPLIANCE_SPECIALIST",
                "EXTERNAL_LEGAL_COUNSEL",
                "LEGAL_OPS_AUDITOR"
              ]
            },
            "verification_method": {
              "type": "string",
              "enum": [
                "LIVE_HTTP_FETCH_AND_LEGAL_REVIEW",
                "OFFICIAL_GAZETTE_ARCHIVE_CHECK",
                "MANUAL_LEGAL_SIGN_OFF",
                "UNVERIFIED_METADATA_ONLY"
              ]
            },
            "audit_log_id": {
              "type": "string",
              "pattern": "^AUD-\\d{8}-[A-Z0-9\\-_]{2,32}$"
            },
            "verified_at": {
              "type": "string"
            },
            "document_fetch_status": {
              "type": "string",
              "enum": [
                "FETCHED_AND_MATCHED",
                "METADATA_VERIFIED_PENDING_LIVE_FETCH",
                "FAILED",
                "NOT_CHECKED"
              ]
            },
            "retrieved_http_status": {
              "type": [
                "integer",
                "null"
              ]
            },
            "retrieved_content_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{64}$"
            },
            "expected_text_markers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 2
              }
            },
            "matched_text_markers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "superseded_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "conflicting_precedent_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification_status": {
                "const": "VERIFIED"
              }
            },
            "required": [
              "verification_status"
            ]
          },
          "then": {
            "properties": {
              "full_text_verification": {
                "properties": {
                  "status": {
                    "const": "FETCHED_AND_MATCHED"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "verification_audit": {
                "properties": {
                  "document_fetch_status": {
                    "const": "FETCHED_AND_MATCHED"
                  }
                },
                "required": [
                  "document_fetch_status"
                ]
              },
              "operative_holding": {
                "properties": {
                  "verified_against_gazette": {
                    "const": true
                  }
                },
                "required": [
                  "verified_against_gazette"
                ]
              },
              "scope_limitations_detail": {
                "properties": {
                  "verified_by_legal_review": {
                    "const": true
                  }
                },
                "required": [
                  "verified_by_legal_review"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "full_text_verification": {
                "properties": {
                  "status": {
                    "enum": [
                      "METADATA_VERIFIED_PENDING_LIVE_FETCH",
                      "UNVERIFIED"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "full_text_verification"
            ]
          },
          "then": {
            "properties": {
              "verification_status": {
                "not": {
                  "const": "VERIFIED"
                }
              },
              "operative_holding": {
                "properties": {
                  "verified_against_gazette": {
                    "const": false
                  }
                },
                "required": [
                  "verified_against_gazette"
                ]
              },
              "scope_limitations_detail": {
                "properties": {
                  "verified_by_legal_review": {
                    "const": false
                  }
                },
                "required": [
                  "verified_by_legal_review"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
